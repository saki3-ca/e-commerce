# ==============================================================
# 🌸 MASFEEH E-COMMERCE ENVIRONMENT CONFIGURATION
# Copy this file to '.env' (in the project root or /server/.env)
# ==============================================================

# ----------------- SERVER CONFIGURATION -----------------
PORT=5000
NODE_ENV=production

# ----------------- SUPABASE DATABASE -----------------
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your URL and Keys
# 3. Paste the contents of 'supabase_schema.sql' into the Supabase SQL Editor
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----------------- STORE & SOCIAL SETTINGS -----------------
OWNER_EMAIL=maishamonsura@gmail.com
OWNER_PHONE=01303-662891
SHOP_ADDRESS="Bashundhara R/A, Dhaka, Bangladesh"

# Official Social Media Links
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61596179578624
# Add your Instagram link anytime (it will automatically show up in header & footer!)
INSTAGRAM_URL=https://www.instagram.com/your_instagram_handle

# ----------------- EMAIL NOTIFICATIONS (GMAIL / SMTP) -----------------
# For automated order alert emails to owner & acceptance notifications to customers:
# (Leave blank for safe simulated local logging, or provide Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, create a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here
SMTP_SECURE=false
SMTP_SENDER_NAME="Masfeeh Online Shop"

# ----------------- ADMIN LOGIN -----------------
# Optional: secret used to sign dashboard login sessions.
# Defaults to one derived from SUPABASE_SERVICE_ROLE_KEY. Changing it logs everyone out.
# ADMIN_SESSION_SECRET=
